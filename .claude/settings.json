{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Edit(/better-xcloud-image-filter.user.js)",
      "Edit(/xcloud-image-filter-play.user.js)",
      "Edit(/output/restoration.bundle.js)",
      "Edit(/script.js)"
    ],
    "ask": [
      "Bash(git push origin v*)",
      "Bash(git push --tags *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.sh"
            ],
            "timeout": 180
          }
        ]
      }
    ]
  }
}
