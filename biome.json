{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": [
			"src/**/*.js",
			"tests/**/*.cjs",
			"player/**/*.js"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": "off",
			"complexity": "off",
			"a11y": "off",
			"performance": "off",
			"security": "off",
			"nursery": "off",
			"suspicious": {
				"noAssignInExpressions": "off",
				"useIterableCallbackReturn": "off"
			}
		}
	}
}
